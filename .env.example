# Conexão com o banco Postgres (Neon, Supabase, Vercel Postgres...).
# Na Vercel, ao adicionar um banco pelo Marketplace, essa variável é criada sozinha.
# Sem ela, rodando LOCALMENTE, o sistema usa um banco temporário em memória (os dados somem ao reiniciar).
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Segredo usado para assinar o login (cookie). Gere um com: openssl rand -base64 32
AUTH_SECRET=troque-por-um-segredo-longo-e-aleatorio
